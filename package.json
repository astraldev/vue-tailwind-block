{
  "name": "vue-tailwind-block",
  "version": "1.0.1",
  "description": "Keep long Tailwind utility classes out of your Vue templates with a typed <tailwind> YAML block for Vite and Nuxt.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "pnpm build && vitest run --project integration",
    "pretest": "pnpm build",
    "docs:dev": "pnpm -C docs dev"
  },
  "keywords": [
    "vue",
    "vue3",
    "tailwind",
    "tailwindcss",
    "nuxt",
    "nuxt-module",
    "vite",
    "yaml",
    "unplugin"
  ],
  "author": "Ekure Edem <61796351+astraldev@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astraldev/vue-tailwind-block.git"
  },
  "homepage": "https://vue-tailwind-block.netlify.app",
  "bugs": {
    "url": "https://github.com/astraldev/vue-tailwind-block/issues"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "dependencies": {
    "magic-string": "catalog:runtime",
    "unplugin": "catalog:runtime",
    "yaml": "catalog:runtime"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:nuxt",
    "@nuxt/schema": "catalog:nuxt",
    "@types/node": "catalog:nuxt",
    "@vue/language-core": "catalog:tooling",
    "eslint": "catalog:tooling",
    "eslint-plugin-better-tailwindcss": "catalog:tooling",
    "eslint-plugin-vue": "catalog:tooling",
    "tailwindcss": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "typescript": "catalog:nuxt",
    "unrun": "catalog:tooling",
    "vite": "catalog:tooling",
    "vitest": "catalog:tooling",
    "vue": "catalog:nuxt",
    "vue-eslint-parser": "catalog:tooling",
    "vue-tsc": "catalog:tooling"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./eslint": "./dist/eslint.mjs",
    "./nuxt": "./dist/nuxt.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json",
    "./volar": {
      "types": "./dist/volar.d.cts",
      "default": "./dist/volar.cjs"
    }
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-plugin-vue": "^9.0.0 || ^10.0.0",
    "typescript": "^6.0.0",
    "vite": ">=5.0.0",
    "vue": "^3.3.0 || ^3.6.0-0",
    "vue-tsc": "^3.2.0",
    "@nuxt/kit": "^3.10.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue-tsc": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    }
  }
}
