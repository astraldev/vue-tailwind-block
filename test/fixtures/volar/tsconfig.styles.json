{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve"
  },
  "include": [
    "src-styles/**/*.vue"
  ],
  "vueCompilerOptions": {
    "plugins": [
      {
        "name": "../../../dist/volar.cjs",
        "variableName": "styles"
      }
    ]
  }
}